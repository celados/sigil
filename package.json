{
	"name": "sigil",
	"version": "0.5.0",
	"description": "Agent-friendly icon package manager: search, add, etch",
	"bin": {
		"sigil": "./src/index.ts"
	},
	"type": "module",
	"scripts": {
		"build": "./scripts/build.sh",
		"check": "bun run typecheck && bun test && bun run fmt:check",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check"
	},
	"dependencies": {
		"@celados/argc": "7.11.1",
		"@iconify/utils": "^3.1.3",
		"@valibot/to-json-schema": "^1.7.1",
		"valibot": "^1.4.1"
	},
	"devDependencies": {
		"@iconify/types": "^2.0.0",
		"@types/bun": "^1.3.14",
		"oxfmt": "^0.54.0",
		"typescript": "^7.0.2"
	}
}
